# teste: stitch, mosaic e knit num filme — o filme em mosaic (com a luz da cena por cima), um plano em knit, um ator
# em stitch (desenhado à parte, na ordem de profundidade, com a grade presa ao quadro do filme)
film fps=4
canvas 320 180 bg=#9fc4de
art mosaic
ambient c=#a0b0d0 power=0.7
light lamp point 260,40 c=#ffd9a0 power=1.2 radius=260

actor a "rosto.weasel" 90,170 scale=0.8
actor b "rosto.weasel" 220,170 scale=0.8 flip=x

layer fundo
rect chao 0,150 320,30 c=#6aa84f
ellipse sol 280,36 18 c=#fff1a8

shot todo dur=1s
at 1s a.pos=110,170

shot trico dur=1s
art knit size=5

shot misto dur=1s
art stitch size=4 actor=b
