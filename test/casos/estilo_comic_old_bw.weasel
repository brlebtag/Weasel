# teste: art comic bw — avisa que bw vale junto com old e vira a tira de jornal (comic old bw): preto chapado,
# linhas deitadas no escuro, hachura no meio, presas à forma (boil=0); sem fundo (bg=none)
canvas 240 160 bg=none light=-0.6,-0.8
palette ink=#1d1b26 line=4 ball=#ff8a5c leaf=#6cbb3c
art comic bw

bone bola pivot=80,90

layer coisas
ellipse b 80,90 34 c=bolaG ink=line bone=bola
gradient bolaG radial 66,74 46 : #ffffff@0 #a07060@0.5 #30202a@1
rect caixa 150,70 50,58 r=6 c=#4a5a80 ink=line
shape folha c=leaf ink=line : 80,56! 96,40 104,52 92,64

anim gira frames=3 fps=6
key 0 bola=0,0,0
key 3 bola=0,0,90
