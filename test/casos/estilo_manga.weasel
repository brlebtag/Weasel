# teste: art manga — preto chapado no mais escuro, papel branco no claro e, no meio, tones= retículas de ponto
# fixo a 45°, paradas na tela; a faixa de sombra do toon vira retícula
canvas 240 160 bg=fundo light=-0.6,-0.8
gradient fundo linear 0,0 240,0 : #ffffff@0 #202020@1
palette ink=#1d1b26 line=4 ball=#ff8a5c leaf=#6cbb3c
art manga tones=4 size=5

bone bola pivot=80,90

layer coisas
ellipse b 80,90 34 c=ball ink=line bone=bola
rect caixa 150,70 50,58 r=6 c=#4a90d9 ink=line
shape folha c=leaf ink=line : 80,56! 96,40 104,52 92,64

anim gira frames=3 fps=6
key 0 bola=0,0,0
key 3 bola=0,0,90
