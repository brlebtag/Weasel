# teste: art chalk — sem fundo (bg=none), o quadro verde-escuro; as cores claras viram giz cheio, as escuras
# quase só o quadro; o contorno em giz branco; boil=2 (o padrão: o giz ferve a cada 2 quadros)
canvas 240 160 bg=none light=-0.6,-0.8
palette ink=#1d1b26 line=4 ball=#ff8a5c leaf=#6cbb3c
art chalk

bone bola pivot=80,90

layer chao
rect solo 0,128 240,32 c=#b9ad98

layer coisas
ellipse sol 212,26 12 c=#fff3b0 emit=#ffd060,1
ellipse b 80,90 34 c=ball ink=line bone=bola
rect caixa 150,70 50,58 r=6 c=#4a90d9 ink=line cut=furo
ellipse furo 175,99 9 hidden
shape folha c=leaf ink=line : 80,56! 96,40 104,52 92,64
stroke galho w=12 c=#6b4a2b taper=0,0.5 : 14,128 34,108 58,100
line fio c=#333333 w=2 dash=6,4 : 10,142 230,142
text nome 120,156 "OI" size=12 align=center c=ink bold

anim gira frames=4 fps=6
key 0 bola=0,0,0
key 4 bola=0,0,60
