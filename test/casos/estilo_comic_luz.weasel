# teste: art comic com luzes — a luz em 3 degraus por cima da faixa de sombra; size= e shadow=
canvas 240 160 bg=#2a2f45 light=-0.6,-0.8
palette ink=#1d1b26 line=4 ball=#ff8a5c leaf=#6cbb3c
ambient c=#6070a0 power=0.5
light lamp point 200,30 c=#ffd9a0 power=1.5 radius=220 glow=40
art comic size=4 shadow=0.4

bone bola pivot=80,90

layer chao
rect solo 0,128 240,32 c=#b9ad98

layer coisas
ellipse b 80,90 34 c=ball ink=line bone=bola
rect caixa 150,70 50,58 r=6 c=#4a90d9 ink=line
shape folha c=leaf ink=line : 80,56! 96,40 104,52 92,64

anim gira frames=3 fps=6
key 0 bola=0,0,0
key 3 bola=0,0,90
