# teste: transições geradas para a sprite sheet (anim … from= to=). to_idle acha as direções sozinho
# (walk_right → idle_right e walk_down → idle_down), uma peça a cada 4 quadros do walk; after_attack parte
# do último quadro do ataque (once), com o nome exato. A poeira (only=walk_*) e o golpe (only=attack_right)
# trocam no meio de cada peça.
canvas 120 120 bg=none
palette ink=#2b2a33 pelo=#c98a5a azul=#3d7dd8

godot body=character root=60,110
bone corpo pivot=60,96
bone cabeca pivot=60,58 parent=corpo
bone pe pivot=60,96 parent=corpo

layer poeira only=walk_right,walk_down
ellipse nuvem 40,108 10,4 c=#d8cbb0

layer bicho
ellipse barriga 60,80 22,18 c=pelo ink=3 bone=corpo
ellipse rosto 60,50 14,13 c=pelo ink=3 bone=cabeca
ellipse olho 66,48 3,3 c=ink bone=cabeca
stroke pata w=6 c=ink bone=pe : 60,94 60,108

box corpo body rect 42,40 36,70
box golpe hit circle 92,70 10 only=attack_right

anim walk_right frames=8 fps=12
key 0 corpo=0,0,0 pe=0,0,25 cabeca=0,0,0
key 4 corpo=0,-6,0 pe=0,0,-25 cabeca=0,0,6
key 8 corpo=0,0,0 pe=0,0,25 cabeca=0,0,0

anim walk_down frames=8 fps=12
key 0 corpo=0,0,0 pe=0,0,10
key 4 corpo=0,-4,0 pe=0,0,-10
key 8 corpo=0,0,0 pe=0,0,10

anim idle_right frames=8 fps=6
key 0 cabeca=0,0,-4 olho.c=#2b2a33
key 4 cabeca=0,0,4 olho.c=#3d7dd8
key 8 cabeca=0,0,-4 olho.c=#2b2a33

anim idle_down frames=8 fps=6
key 0 corpo=0,0,0
key 4 corpo=0,2,0
key 8 corpo=0,0,0

anim attack_right frames=6 fps=12 once
key 0 corpo=0,0,0 cabeca=0,0,0
key 3 corpo=8,0,-10 cabeca=0,0,-15
key 5 corpo=10,0,-12 cabeca=0,0,-20

anim to_idle from=walk to=idle frames=3 every=4
anim after_attack from=attack_right to=idle_right frames=3
