# teste: as HQs num filme — o filme em comic old (com a luz da cena em degraus), um plano em manga, um ator
# em riso (desenhado à parte, na ordem de profundidade), um plano em comic old bw e um em woodcut
film fps=4
canvas 320 180 bg=#1d2b53
art comic old
ambient c=#8090b0 power=0.6
light lamp point 260,40 c=#ffd9a0 power=1.3 radius=260

actor a "rosto.weasel" 90,170 scale=0.8
actor b "rosto.weasel" 220,170 scale=0.8 flip=x

layer fundo
rect chao 0,150 320,30 c=#008751
ellipse lua 280,36 18 c=#fff1e8

shot todo dur=1s
at 1s a.pos=110,170

shot manga dur=1s
art manga

shot misto dur=1s
art riso actor=b

shot tira dur=1s
art comic old bw

shot xilo dur=1s
art woodcut
