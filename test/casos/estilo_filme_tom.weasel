# teste: estilos de tom num filme — o filme em toon (com a luz da cena), um plano em engraving (a hachura
# presa aos atores), um ator em halftone color (desenhado à parte, na ordem de profundidade) e um plano em
# silhouette
film fps=4
canvas 320 180 bg=#1d2b53
art toon
ambient c=#8090b0 power=0.6
light lamp point 260,40 c=#ffd9a0 power=1.3 radius=260

actor a "rosto.weasel" 90,170 scale=0.8
actor b "rosto.weasel" 220,170 scale=0.8 flip=x

layer fundo
rect chao 0,150 320,30 c=#008751
ellipse lua 280,36 18 c=#fff1e8

shot todo dur=1s
at 1s a.pos=110,170

shot gravura dur=1s
art engraving levels=0.05,0.9

shot misto dur=1s
art halftone color actor=b

shot sombra dur=1s
art silhouette
