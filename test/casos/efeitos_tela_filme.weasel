# teste: os efeitos de tela num filme — oldfilm (sépia, riscos, poeira, a luz piscando e o quadro tremendo) no filme
# todo, mudando a cada quadro
film fps=4
canvas 320 180 bg=#9fc4de
finish oldfilm=1

actor a "rosto.weasel" 90,170 scale=0.8
actor b "rosto.weasel" 220,170 scale=0.8 flip=x

layer fundo
rect chao 0,150 320,30 c=#6aa84f
ellipse sol 280,36 18 c=#fff1a8

shot todo dur=1s
at 1s a.pos=110,170

shot perto dur=1s
camera 160,120 zoom=1.6
