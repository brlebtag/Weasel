# teste: o boneco do mistura.weasel (blend= no filme). O braço gira para lados opostos nas duas animações
# (170° e -170°: a mistura vai pelo lado mais curto, passando por 180°), o tronco muda de cor, o chapéu some
# só numa delas e a boca troca de forma (morph).
canvas 200 200 bg=none
palette ink=#2b2a33 pele=#ffcf8a azul=#3d7dd8

bone corpo pivot=100,160
bone braco pivot=100,112 parent=corpo

layer boneco
rect tronco 80,100 40,60 c=azul ink=3 bone=corpo
stroke bracoL w=8 c=ink bone=braco : 100,112 150,112
ellipse cabeca 100,80 18,18 c=pele ink=3 bone=corpo
shape boca c=#c44536 bone=corpo : 92,84 108,84 104,88 96,88
shape boca_aberta c=#c44536 bone=corpo hidden : 92,82 108,82 104,96 96,96
ellipse chapeu 100,58 16,7 c=#e0b030 bone=corpo

anim parado frames=12 fps=12
key 0 braco=0,0,170
key 6 braco=0,0,160
key 12 braco=0,0,170

anim acena frames=12 fps=12
key 0 braco=0,0,-170 corpo=0,-12 tronco.c=#d84a3d chapeu.opacity=0.15 boca.shape=boca_aberta
key 6 braco=0,0,-140
key 12 braco=0,0,-170
